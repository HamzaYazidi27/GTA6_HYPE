# secrets
.env
.secrets/
*.pem
client_secret*.json
token*.json

# python / node
.venv/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
templates/.bundle/
.remotion/

# runtime data (jobs are working state, outputs are deliverables)
jobs/*
!jobs/.gitkeep
outputs/*
!outputs/.gitkeep

# local model weights and caches (downloaded by `python -m gta_factory setup`)
assets/models/*
!assets/models/.gitkeep
reference_analysis/.cache/

# generated audio beds are rebuilt by `python -m gta_factory setup` (kept out of git to stay small)
assets/music/*.wav
assets/sound_effects/*.wav

.DS_Store
*.log

# learned channel memory lives next to the database (jobs/factory.sqlite3)
knowledge/auto_timeline.json
# generated by `python -m gta_factory setup`
assets/music/LIBRARY.json
assets/sound_effects/LIBRARY.json
*.egg-info/

# real GTA 6 footage (official trailers / screenshots, downloaded by `python -m gta_factory footage fetch`)
assets/gta6_footage/*
!assets/gta6_footage/README.md
# other games' footage for comparisons (`python -m gta_factory footage update --game rdr2`)
assets/game_footage/*
!assets/game_footage/README.md
