# Copy to .env and fill in only what you use. Never commit .env.

# --- LLM providers (pick one in config.yaml -> providers.llm.default) ---------
# claude_code needs no key here: it uses the Claude Code CLI you are logged in to (`claude login`).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Voice providers (config.yaml -> providers.tts.default) -------------------
# kokoro is local and needs no key.
ELEVENLABS_API_KEY=

# --- Optional licensed b-roll --------------------------------------------------
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Optional: richer competitor analysis through the official Data API -------
YOUTUBE_API_KEY=

# --- Optional: publishing (disabled unless youtube.upload_enabled is true) ----
# Path to an OAuth client-secrets JSON downloaded from Google Cloud Console.
YOUTUBE_CLIENT_SECRETS_FILE=
